# Copie para .env. Todos os valores abaixo são fake mas válidos: o schema de
# ambiente (platform/config/environment.contracts.ts) rejeita o boot se faltar.

NODE_ENV=development
PORT=3000

DATABASE_URL=postgresql://app:app@localhost:5432/app

# Mínimo de 32 caracteres. Em produção, gere com: openssl rand -hex 32
JWT_ACCESS_SECRET=dev-only-access-secret-change-me-0123456789
JWT_ACCESS_TTL_SECONDS=900
JWT_REFRESH_SECRET=dev-only-refresh-secret-change-me-0123456789
JWT_REFRESH_TTL_SECONDS=2592000

LOG_LEVEL=debug

# CSV de origens de browser. Vazio = nenhuma.
CORS_ALLOWED_ORIGINS=

# Único caminho para criar um admin (pnpm db:seed). Sem endpoint, de propósito.
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_PASSWORD=change-me-please-12345
