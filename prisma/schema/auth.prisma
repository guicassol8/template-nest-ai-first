model RefreshToken {
  id        String    @id @default(uuid())
  userId    String
  familyId  String
  tokenHash String
  revokedAt DateTime?
  createdAt DateTime  @default(now())
  expiresAt DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([familyId])
  // Para varreduras globais de expirados (a limpeza por usuário usa o índice de userId).
  @@index([expiresAt])
}

enum UserRole {
  admin
  user
}
