{
  "name": "template-nest-ai-first",
  "version": "0.1.0",
  "private": true,
  "description": "Esqueleto de API NestJS com autenticacao JWT, desenhado para ser mantido por agentes",
  "license": "MIT",
  "packageManager": "pnpm@11.20.0",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "prepare": "if [ -d .git ] && [ -d .githooks ]; then git config core.hooksPath .githooks && chmod +x .githooks/*; fi",
    "dev": "nest start --watch",
    "build": "nest build",
    "start": "node dist/main.js",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "test:e2e": "vitest run --config vitest.e2e.config.mts",
    "arch:check": "depcruise src --config .dependency-cruiser.cjs && bash scripts/check-conventions.sh",
    "openapi:generate": "tsc -p tsconfig.openapi.json && node dist-openapi/scripts/emit-openapi-document.js",
    "openapi:check": "pnpm openapi:generate && [ -z \"$(git status --porcelain -- openapi.json)\" ]",
    "verify:fast": "pnpm lint && pnpm typecheck",
    "verify": "pnpm verify:fast && pnpm test && pnpm arch:check && pnpm openapi:check",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@nestjs/common": "^11.1.28",
    "@nestjs/config": "^4.0.4",
    "@nestjs/core": "^11.1.28",
    "@nestjs/jwt": "^11.0.2",
    "@nestjs/platform-express": "^11.1.28",
    "@nestjs/swagger": "^11.4.6",
    "@nestjs/terminus": "^11.1.1",
    "@nestjs/throttler": "^6.5.0",
    "@prisma/adapter-pg": "^7.9.1",
    "@prisma/client": "^7.9.1",
    "argon2": "^0.45.1",
    "helmet": "^8.3.0",
    "nestjs-pino": "^4.6.1",
    "nestjs-zod": "^5.5.0",
    "pino": "^10.3.1",
    "pino-http": "^11.0.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@nestjs/cli": "^11.0.24",
    "@nestjs/testing": "^11.1.28",
    "@swc/core": "^1.15.47",
    "@types/express": "^5.0.6",
    "@types/node": "^24.13.3",
    "@types/supertest": "^7.2.1",
    "@vitest/coverage-v8": "^4.1.10",
    "dependency-cruiser": "^18.1.1",
    "eslint": "^10.8.1",
    "pino-pretty": "^13.1.3",
    "prisma": "^7.9.1",
    "supertest": "^7.2.2",
    "tsx": "^4.23.11",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.66.0",
    "unplugin-swc": "^1.5.10",
    "vitest": "^4.1.10"
  }
}
